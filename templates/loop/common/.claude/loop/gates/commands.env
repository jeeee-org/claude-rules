# 決定論ゲートが回すコマンド。このリポに合わせて埋める（空のままのものを使うゲートは不合格になる）。
BUILD_CMD=""   # 例: npm run build / cargo build / go build ./...
LINT_CMD=""    # 例: npm run lint / ruff check . / cargo clippy -- -D warnings
TYPE_CMD=""    # 例: npx tsc --noEmit / mypy src
TEST_CMD=""    # 例: npm test / pytest -q / go test ./...
