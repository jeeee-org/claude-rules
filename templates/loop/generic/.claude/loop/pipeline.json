{
  "version": 1,
  "profile": "generic",
  "conductor": "loop-conductor",
  "max_auto_continues": 3,
  "max_rework": 3,
  "time_budget_sec": null,
  "limits": {
    "time_budget_hard": false,
    "max_total_rework": 10,
    "max_shards": 30,
    "max_items": 100
  },
  "must_stop": [
    "共有ブランチへのpush",
    "PRのマージ",
    "デプロイ・本番への反映",
    "外へのメッセージの送信",
    "データの削除"
  ],
  "sunset_min_runs": 10,
  "judge": {
    "agent": "gate-judge",
    "default_threshold": 0.9,
    "target_accuracy": 0.95,
    "min_samples": 20,
    "audit_rate": 0.1,
    "promote_min_fires": 5,
    "max_promoted_per_step": 3
  },
  "steps": [
    {
      "id": "collect",
      "title": "集める",
      "worker": "step-worker",
      "reviewer": "step-reviewer",
      "gate": "gates/outputs.sh",
      "instructions": "（例）題材に要る材料を集め、出典付きで loop-out/collect.md にまとめる。ここを各リポの作業に書き換える",
      "review_focus": "材料の抜け・出典の確かさ・題材との関係",
      "outputs": [
        "loop-out/collect.md"
      ],
      "parallel": 3,
      "judge_questions": []
    },
    {
      "id": "draft",
      "title": "書く",
      "worker": "step-worker",
      "reviewer": "step-reviewer",
      "gate": "gates/outputs.sh",
      "instructions": "（例）collect.md をもとに loop-out/draft.md を書く",
      "review_focus": "材料に無いことを書いていないか・読み手に通じるか",
      "outputs": [
        "loop-out/draft.md"
      ],
      "judge_questions": [
        {
          "id": "draft-grounded",
          "question": "draft.md の主張はすべて collect.md の材料に裏付けがあるか",
          "answers": [
            "yes",
            "no"
          ],
          "pass": "yes"
        }
      ]
    },
    {
      "id": "finish",
      "title": "仕上げ",
      "worker": "step-worker",
      "reviewer": null,
      "gate": "gates/outputs.sh",
      "instructions": "（例）draft.md を体裁の決まりに合わせて loop-out/final.md にする",
      "outputs": [
        "loop-out/final.md"
      ],
      "judge_questions": []
    }
  ]
}
